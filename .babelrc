{
    "plugins": [
        "transform-object-rest-spread",
        "@babel/plugin-proposal-optional-chaining",
        ["react-intl", {
            "messagesDir": "./translations/messages/"
        }]
    ],
    "presets": [["env", {"targets": {"browsers": ["last 3 versions", "Safari >= 8", "iOS >= 8"]}}], "react"]
}
